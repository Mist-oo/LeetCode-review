{
  "schema": 1,
  "number": 215,
  "conditions": [
    "按数值从大到小对所有元素排名，重复值分别占据名次，返回第 k 个元素值。",
    "k 从 1 开始且合法，不是第 k 个不同值；原题要求 O(n) 时间。"
  ],
  "constraints_html": "<ul>\n\t<li><code>1 &lt;= k &lt;= nums.length &lt;= 10<sup>5</sup></code></li>\n\t<li><code>-10<sup>4</sup>&nbsp;&lt;= nums[i] &lt;= 10<sup>4</sup></code></li>\n</ul>",
  "source": "https://github.com/doocs/leetcode/blob/2104ae8bdd661a1ebb6b5c703f050b8060b51e32/solution/0200-0299/0215.Kth%20Largest%20Element%20in%20an%20Array/README.md",
  "versions": [
    {
      "id": "fixed-215-1",
      "title": "查询指定排名的分值",
      "statement": "一组分值未排序，可能多人同分。请将每个记录都视为独立名次，求从高到低第 k 个记录的分值；同分不能去重，返回数值而非下标。",
      "examples": [
        [
          [
            -3,
            0,
            -2,
            -2,
            -1,
            5,
            1,
            3
          ],
          3
        ],
        [
          [
            -3
          ],
          1
        ]
      ],
      "expected_output": "1\n-3\n"
    },
    {
      "id": "fixed-215-2",
      "title": "挑出第几高的测量结果",
      "statement": "设备产生若干整数读数。请报告按大小降序排名第 k 的读数，重复读数也要分别计数，并满足原线性时间要求。",
      "examples": [
        [
          [
            5,
            1,
            4,
            0,
            3,
            4
          ],
          2
        ],
        [
          [
            3,
            0,
            5,
            2,
            -5
          ],
          5
        ]
      ],
      "expected_output": "4\n-5\n"
    },
    {
      "id": "fixed-215-3",
      "title": "确定奖励分数门槛",
      "statement": "要按成绩从高到低取前 k 条记录，现在只需知道第 k 条记录的成绩。输入可能包含相同成绩，相同成绩的不同记录仍各占一名。",
      "examples": [
        [
          [
            0,
            -4,
            -5
          ],
          1
        ],
        [
          [
            5,
            5,
            -1
          ],
          3
        ]
      ],
      "expected_output": "0\n-1\n"
    }
  ]

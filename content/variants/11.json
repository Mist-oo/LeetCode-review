  "conditions": [
    "第 i 条竖直边界位于横坐标 i，高度为 height[i]，相邻横坐标距离为 1。",
    "选择两条边界与横轴围成容器，不得倾斜；容量为两条边界间距乘较矮一条的高度，返回最大容量。"
  ],
  "constraints_html": "<ul>\n\t<li><code>n == height.length</code></li>\n\t<li><code>2 &lt;= n &lt;= 10<sup>5</sup></code></li>\n\t<li><code>0 &lt;= height[i] &lt;= 10<sup>4</sup></code></li>\n</ul>",
  "source": "https://github.com/doocs/leetcode/blob/2104ae8bdd661a1ebb6b5c703f050b8060b51e32/solution/0000-0099/0011.Container%20With%20Most%20Water/README.md",
  "versions": [

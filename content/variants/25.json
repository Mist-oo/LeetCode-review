  "conditions": [
    "从链头起每 k 个节点构成一组，组内节点顺序反转，组间先后不变。",
    "k 是不超过长度的正整数；最后不足 k 个节点保持原顺序。",
    "必须实际调整节点链接，不只是改写节点值；内部节点操作由使用者自查。"
  ],
  "constraints_html": "<ul>\n\t<li>链表中的节点数目为 <code>n</code></li>\n\t<li><code>1 &lt;= k &lt;= n &lt;= 5000</code></li>\n\t<li><code>0 &lt;= Node.val &lt;= 1000</code></li>\n</ul>",
  "source": "https://github.com/doocs/leetcode/blob/2104ae8bdd661a1ebb6b5c703f050b8060b51e32/solution/0000-0099/0025.Reverse%20Nodes%20in%20k-Group/README.md",
  "versions": [
    {
      "id": "fixed-25-1",
      "title": "整组调转交接顺序",
      "statement": "一条单向交接链需要按固定人数 k 分组。每个完整小组内部的站点顺序倒过来，但小组之间的位置不变；末尾凑不齐一组的站点不能动。请给出调整后的整条链。",
      "examples": [
        [
          [
            3
          ],
          1
        ],
        [
          [
            7,
            7
          ],
          2
        ]
      ],
      "expected_output": "3\n7 7\n"
    },
    {
      "id": "fixed-25-2",
      "title": "按批次重排任务链",
      "statement": "任务沿单链表依次连接，调度规则是每连续 k 项为一批，将完整批次反向链接。剩余不到 k 项的任务照旧接在末尾，节点自身的数值不得修改。",
      "examples": [
        [
          [
            0,
            1,
            2,
            5,
            3,
            7,
            6
          ],
          4
        ],
        [
          [
            3,
            9,
            5,
            6,
            9,
            0,
            3,
            5
          ],
          5
        ]
      ],
      "expected_output": "5 2 1 0 3 7 6\n9 6 5 9 3 0 3 5\n"
    },
    {
      "id": "fixed-25-3",
      "title": "成组翻转档案接续关系",
      "statement": "档案链要每 k 个节点做一次组内前后互换。请保留所有节点及其数值，只调整链接关系；只有完整的一组才操作，不完整的尾段保留原样。",
      "examples": [
        [
          [
            5,
            8
          ],
          2
        ],
        [
          [
            1,
            1,
            8,
            5
          ],
          3
        ]
      ],
      "expected_output": "8 5\n8 1 1 5\n"
    }
  ]
}

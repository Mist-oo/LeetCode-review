  "conditions": [
    "每根柱子的宽度为 1，高度为非负整数，柱子按给定顺序排列。",
    "雨水只在左右边界共同限制的凹处积存，不能从外侧凭空围水；返回总积水量。"
  ],
  "constraints_html": "<ul>\n\t<li><code>n == height.length</code></li>\n\t<li><code>1 &lt;= n &lt;= 2 * 10<sup>4</sup></code></li>\n\t<li><code>0 &lt;= height[i] &lt;= 10<sup>5</sup></code></li>\n</ul>",
  "source": "https://github.com/doocs/leetcode/blob/2104ae8bdd661a1ebb6b5c703f050b8060b51e32/solution/0000-0099/0042.Trapping%20Rain%20Water/README.md",
  "versions": [

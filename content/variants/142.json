        [
          [
            9,
            5,
            2,
            5,
            2,
            4,
            0,
            9
          ],
          0
        ]
      ],
      "expected_output": "-1\n0\n"
    },
    {
      "id": "fixed-142-3",
      "title": "追踪循环引用的入口",
      "statement": "记录链可能包含一段正常前缀和一段循环引用。请确定从链头前进时最早进入循环的记录位置；若整个结构无环则输出约定的不存在标记，不能用数值相等替代节点相同。",
      "examples": [
        [
          [
            0,
            0,
            0,
            7,
            9,
            6,
            0
          ],
          2
        ],
        [
          [
            4,
            5,
            3,
            4,
            0,
            4,
            2
          ],
          4
        ]
      ],
      "expected_output": "2\n4\n"

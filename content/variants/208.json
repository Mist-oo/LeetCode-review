  "conditions": [
    "维护初始为空的小写英文词条集合，insert 登记词条，search 仅在完整词条已登记时返回 true。",
    "startsWith 查询是否至少有一个已登记词条以给定前缀开头；不能把前缀存在当成完整词条存在。",
    "重复插入不产生额外查询结果，按操作顺序执行；每组重新初始化，只输出查询结果。"
  ],
  "constraints_html": "<ul>\n\t<li><code>1 &lt;= word.length, prefix.length &lt;= 2000</code></li>\n\t<li><code>word</code> 和 <code>prefix</code> 仅由小写英文字母组成</li>\n\t<li><code>insert</code>、<code>search</code> 和 <code>startsWith</code> 调用次数 <strong>总计</strong> 不超过 <code>3 * 10<sup>4</sup></code> 次</li>\n</ul>",
  "source": "https://github.com/doocs/leetcode/blob/2104ae8bdd661a1ebb6b5c703f050b8060b51e32/solution/0200-0299/0208.Implement%20Trie%20%28Prefix%20Tree%29/README.md",

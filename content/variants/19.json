            4,
            8,
            6
          ],
          3
        ]
      ],
      "expected_output": "2\n3 0 8 6\n"
    },
    {
      "id": "fixed-19-3",
      "title": "调整末端计数名单",
      "statement": "名单按单链表保存，操作员从最后一项开始编号为 1、2 等。请移除编号为 n 的节点，返回调整后的名单；若原来只有一个节点，结果可为空。",
      "examples": [
        [
          [
            9
          ],
          1
        ],
        [

  "conditions": [
    "检查根的左、右两部分是否互为镜像，既比较形状也比较对应节点值。",
    "仅每层数值看起来对称或节点集合相同都不充分，缺失子节点的位置也参与比较。"
  ],
  "constraints_html": "<ul>\n\t<li>树中节点数目在范围 <code>[1, 1000]</code> 内</li>\n\t<li><code>-100 &lt;= Node.val &lt;= 100</code></li>\n</ul>",
  "source": "https://github.com/doocs/leetcode/blob/2104ae8bdd661a1ebb6b5c703f050b8060b51e32/solution/0100-0199/0101.Symmetric%20Tree/README.md",
  "versions": [
    {
      "id": "fixed-101-1",
      "title": "核验对称展台",
      "statement": "展台的二叉布局希望关于中心线对称。请检查根两侧的分支是否在形状和对应数值上都互为镜像；某一侧缺少节点时，镜像位置也必须缺少。",
      "examples": [
        [
          [
            -1,
            1,
            3,
            0,
            null,
            0
          ]
        ],
        [
          [
            1,
            0,
            -1,
            1,
            null,
            null,
            null,
            null,
            0
          ]
        ]
      ],
      "expected_output": "false\nfalse\n"
    },
    {
      "id": "fixed-101-2",
      "title": "检查左右镜像配置",
      "statement": "设备配置保存为二叉树。审核规则要求每一个左侧分支都与另一边对应的右侧分支匹配，节点值也必须一致。请判断整个配置是否符合镜像要求，不能只比较每层数值列表。",
      "examples": [
        [
          [
            3,
            3,
            -2,
            3,
            null,
            null,
            2
          ]
        ],
        [
          [
            1,
            null,
            -3,
            -3,
            null,
            null,
            2
          ]
        ]
      ],
      "expected_output": "false\nfalse\n"
    },
    {
      "id": "fixed-101-3",
      "title": "确认层级标牌是否对称",
      "statement": "标牌节点组成二叉层级，数值表示标牌内容。请判断以根为中心进行左右镜像后，所有标牌内容及空位是否与原结构一致。即使数值重复，空位位置仍不可忽略。",
      "examples": [
        [
          [
            -1,
            3,
            -3,
            null,
            null,
            1,
            null,
            -2,
            2
          ]
        ],
        [
          [
            -3,
            null,
            -1,
            1,
            0,
            2,
            null,
            null,
            null,
            -2
          ]
        ]
      ],
      "expected_output": "false\nfalse\n"
